# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# Tests / tooling
.pytest_cache/
.ruff_cache/

# Market data snapshots.
# One small sample snapshot is committed on purpose (see data/snapshots/README.md)
# so the notebooks run with no live pull needed. Everything else is local noise.
data/snapshots/*.csv
!data/snapshots/sample_*.csv

# Diagnostic scripts: scratch work to verify an API by hand, not part of the
# public repo. Findings from running them belong in CLAUDE.md, not in git.
scripts/test_yfinance.py
scripts/peek_chain.py

# Generated figures, except the ones the README links to.
# Must be figures/* not figures/. Git won't check a negation for a file inside
# a directory that's ignored outright, it never descends into it to look.
figures/*
!figures/surface.png
!figures/sample_surface.html

# OS
.DS_Store
Thumbs.db

# Local working documents, deliberately not published.
CLAUDE.md
PLAN.md
